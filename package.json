{
  "name": "cellar-book",
  "private": true,
  "version": "0.1.0",
  "description": "A personal wine cellar catalog: what you own, what you paid, and when to drink it.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.e2e.json",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test && npm run build",
    "e2e": "playwright test"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "barcode-detector": "3.2.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "zxing-wasm": "3.1.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}

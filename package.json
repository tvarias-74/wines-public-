{
  "name": "cellar-book",
  "private": true,
  "version": "0.1.0",
  "description": "A personal wine cellar catalog: what you own, what you paid, and when to drink it.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
